@model NBApp.ViewModels.CitySuburbViewModel
@{
    ViewData["Title"] = "Cities & Suburbs";
    var editCityID = TempData["EditCityID"] as int?;
    var editSuburbID = TempData["EditSuburbID"] as int?;
    var activeSection = TempData["ActiveSection"] as string ?? "";
}

<div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-medium text-gray-900 mb-6">Cities & Suburbs</h1>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm">
            @TempData["Error"]
        </div>
    }

   
    <div class="bg-white border border-gray-200 rounded-xl p-5 mb-6">
        <h2 class="text-base font-medium text-gray-900 mb-4">Cities</h2>

     
        @if (editCityID == null)
        {
            <form asp-action="AddCity" method="post" class="flex flex-wrap gap-3 items-end mb-5">
                @Html.AntiForgeryToken()
                <div class="flex flex-col gap-1">
                    <label asp-for="CityForm.CityName" class="text-xs text-gray-500">City name</label>
                    <input asp-for="CityForm.CityName" class="text-sm px-3 py-1.5 border border-gray-200 rounded-lg w-48 focus:outline-none focus:ring-1 focus:ring-gray-400" placeholder="e.g. Suva" />
                    <span asp-validation-for="CityForm.CityName" class="text-xs text-red-600"></span>
                </div>
                <button type="submit" class="text-sm px-4 py-1.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                    + Add city
                </button>
            </form>
        }

       
        <div class="overflow-auto max-h-56 border border-gray-100 rounded-lg">
            <table class="w-full text-sm min-w-[320px]">
                <thead>
                    <tr class="bg-gray-50 sticky top-0 z-10">
                        <th class="text-left text-xs font-medium text-gray-500 px-3 py-2 border-b border-gray-100">Name</th>
                        <th class="text-left text-xs font-medium text-gray-500 px-3 py-2 border-b border-gray-100">Suburbs</th>
                        <th class="text-left text-xs font-medium text-gray-500 px-3 py-2 border-b border-gray-100">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var city in Model.Cities)
                    {
                        <tr class="border-b border-gray-100 last:border-0">
                            <td class="px-3 py-2 text-gray-900">@city.CityName</td>
                            <td class="px-3 py-2">
                                <span class="text-xs px-2 py-0.5 rounded-md bg-blue-50 text-blue-700">
                                    @(city.Suburbs?.Count ?? 0) suburb@(city.Suburbs?.Count == 1 ? "" : "s")
                                </span>
                            </td>
                            <td class="px-3 py-2 flex gap-2">
                                <a asp-action="EditCity" asp-route-id="@city.CityID"
                                   class="text-xs px-3 py-1 border border-gray-200 rounded-md hover:bg-gray-50 transition">
                                    Edit
                                </a>
                                <form asp-action="DeleteCity" method="post" onsubmit="return confirm('Delete @city.CityName?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@city.CityID" />
                                    <button type="submit" class="text-xs px-3 py-1 border border-red-200 text-red-600 rounded-md hover:bg-red-50 transition">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>

                        @if (editCityID == city.CityID)
                        {
                            <tr>
                                <td colspan="3" class="px-3 py-3 bg-gray-50 border-b border-gray-100">
                                    <form asp-action="UpdateCity" method="post" class="flex flex-wrap gap-3 items-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" asp-for="CityForm.CityID" />
                                        <div class="flex flex-col gap-1">
                                            <label class="text-xs text-gray-500">City name</label>
                                            <input asp-for="CityForm.CityName"
                                                   class="text-sm px-3 py-1.5 border border-gray-300 rounded-lg w-48 focus:outline-none focus:ring-1 focus:ring-gray-400" />
                                            <span asp-validation-for="CityForm.CityName" class="text-xs text-red-600"></span>
                                        </div>
                                        <button type="submit" class="text-sm px-4 py-1.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                                            Save
                                        </button>
                                        <a asp-action="Index" class="text-sm px-4 py-1.5 text-gray-500 hover:text-gray-700 transition">
                                            Cancel
                                        </a>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    @if (!Model.Cities.Any())
                    {
                        <tr>
                            <td colspan="3" class="px-3 py-4 text-center text-sm text-gray-400">No cities yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

   
    <div class="bg-white border border-gray-200 rounded-xl p-5">
        <h2 class="text-base font-medium text-gray-900 mb-4">Suburbs</h2>

        
        @if (editSuburbID == null)
        {
            <form asp-action="AddSuburb" method="post" class="flex flex-wrap gap-3 items-end mb-5">
                @Html.AntiForgeryToken()
                <div class="flex flex-col gap-1">
                    <label asp-for="SuburbForm.SuburbName" class="text-xs text-gray-500">Suburb name</label>
                    <input asp-for="SuburbForm.SuburbName" class="text-sm px-3 py-1.5 border border-gray-200 rounded-lg w-44 focus:outline-none focus:ring-1 focus:ring-gray-400" placeholder="e.g. Samabula" />
                    <span asp-validation-for="SuburbForm.SuburbName" class="text-xs text-red-600"></span>
                </div>
                <div class="flex flex-col gap-1">
                    <label asp-for="SuburbForm.DeliveryCost" class="text-xs text-gray-500">Delivery cost ($)</label>
                    <input asp-for="SuburbForm.DeliveryCost" type="text" inputmode="decimal"
                           class="text-sm px-3 py-1.5 border border-gray-200 rounded-lg w-28 focus:outline-none focus:ring-1 focus:ring-gray-400" placeholder="0.00" />
                    <span asp-validation-for="SuburbForm.DeliveryCost" class="text-xs text-red-600"></span>
                </div>
                <div class="flex flex-col gap-1">
                    <label asp-for="SuburbForm.CityID" class="text-xs text-gray-500">City</label>
                    <select asp-for="SuburbForm.CityID"
                            asp-items="@(new SelectList(Model.Cities, "CityID", "CityName"))"
                            class="text-sm px-3 py-1.5 border border-gray-200 rounded-lg w-36 focus:outline-none focus:ring-1 focus:ring-gray-400">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="SuburbForm.CityID" class="text-xs text-red-600"></span>
                </div>
                <button type="submit" class="text-sm px-4 py-1.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                    + Add suburb
                </button>
            </form>
        }

     
        <div class="overflow-auto max-h-56 border border-gray-100 rounded-lg">
            <table class="w-full text-sm min-w-[420px]">
                <thead>
                    <tr class="bg-gray-50 sticky top-0 z-10">
                        <th class="text-left text-xs font-medium text-gray-500 px-3 py-2 border-b border-gray-100">Suburb name</th>
                        <th class="text-left text-xs font-medium text-gray-500 px-3 py-2 border-b border-gray-100">Delivery cost</th>
                        <th class="text-left text-xs font-medium text-gray-500 px-3 py-2 border-b border-gray-100">City</th>
                        <th class="text-left text-xs font-medium text-gray-500 px-3 py-2 border-b border-gray-100">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var suburb in Model.Suburbs)
                    {
                        <tr class="border-b border-gray-100 last:border-0">
                            <td class="px-3 py-2 text-gray-900">@suburb.SuburbName</td>
                            <td class="px-3 py-2 text-gray-700">@suburb.DeliveryCost?.ToString("F2")</td>
                            <td class="px-3 py-2 text-gray-700">@suburb.City?.CityName</td>
                            <td class="px-3 py-2 flex gap-2">
                                <a asp-action="EditSuburb" asp-route-id="@suburb.SuburbID"
                                   class="text-xs px-3 py-1 border border-gray-200 rounded-md hover:bg-gray-50 transition">
                                    Edit
                                </a>
                                <form asp-action="DeleteSuburb" method="post" onsubmit="return confirm('Delete @suburb.SuburbName?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@suburb.SuburbID" />
                                    <button type="submit" class="text-xs px-3 py-1 border border-red-200 text-red-600 rounded-md hover:bg-red-50 transition">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>

                        
                        @if (editSuburbID == suburb.SuburbID)
                        {
                            <tr>
                                <td colspan="4" class="px-3 py-3 bg-gray-50 border-b border-gray-100">
                                    <form asp-action="UpdateSuburb" method="post" class="flex flex-wrap gap-3 items-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" asp-for="SuburbForm.SuburbID" />
                                        <div class="flex flex-col gap-1">
                                            <label class="text-xs text-gray-500">Suburb name</label>
                                            <input asp-for="SuburbForm.SuburbName"
                                                   class="text-sm px-3 py-1.5 border border-gray-300 rounded-lg w-44 focus:outline-none focus:ring-1 focus:ring-gray-400" />
                                            <span asp-validation-for="SuburbForm.SuburbName" class="text-xs text-red-600"></span>
                                        </div>
                                        <div class="flex flex-col gap-1">
                                            <label class="text-xs text-gray-500">Delivery cost ($)</label>
                                            <input asp-for="SuburbForm.DeliveryCost" type="text" inputmode="decimal"
                                                   class="text-sm px-3 py-1.5 border border-gray-300 rounded-lg w-28 focus:outline-none focus:ring-1 focus:ring-gray-400" />
                                            <span asp-validation-for="SuburbForm.DeliveryCost" class="text-xs text-red-600"></span>
                                        </div>
                                        <div class="flex flex-col gap-1">
                                            <label class="text-xs text-gray-500">City</label>
                                            <select asp-for="SuburbForm.CityID"
                                                    asp-items="@(new SelectList(Model.Cities, "CityID", "CityName"))"
                                                    class="text-sm px-3 py-1.5 border border-gray-300 rounded-lg w-36 focus:outline-none focus:ring-1 focus:ring-gray-400">
                                            </select>
                                            <span asp-validation-for="SuburbForm.CityID" class="text-xs text-red-600"></span>
                                        </div>
                                        <button type="submit" class="text-sm px-4 py-1.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                                            Save
                                        </button>
                                        <a asp-action="Index" class="text-sm px-4 py-1.5 text-gray-500 hover:text-gray-700 transition">
                                            Cancel
                                        </a>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    @if (!Model.Suburbs.Any())
                    {
                        <tr>
                            <td colspan="4" class="px-3 py-4 text-center text-sm text-gray-400">No suburbs yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
