@{
    ViewData["Title"] = "Reports";
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900">Reports</h1>
        <p class="text-sm text-gray-500 mt-1">Sales, orders, and product performance</p>
    </div>
</div>

<div class="flex flex-wrap items-center gap-3 mb-6">
    <span class="text-xs font-semibold uppercase tracking-widest text-gray-400">Filter</span>

    <select id="rangeFilter"
            class="text-sm border border-gray-200 rounded-lg px-3 py-2 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="3">Last 3 months</option>
        <option value="6">Last 6 months</option>
        <option value="12" selected>Last 12 months</option>
    </select>

    <select id="statusFilter"
            class="text-sm border border-gray-200 rounded-lg px-3 py-2 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="All">All statuses</option>
        <option value="Pending">Pending</option>
        <option value="Completed">Completed</option>
        <option value="Cancelled">Cancelled</option>
    </select>

    <span id="loadingSpinner" class="hidden text-xs text-gray-400 ml-1">Loading...</span>
</div>

<div class="grid grid-cols-2 gap-4 mb-6 lg:grid-cols-4">
    <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-1">Total revenue</p>
        <p class="text-2xl font-semibold text-gray-900" id="statRevenue">—</p>
        <p class="text-xs text-gray-400 mt-1" id="statRevSub">in period</p>
    </div>
    <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-1">Orders</p>
        <p class="text-2xl font-semibold text-gray-900" id="statOrders">—</p>
        <p class="text-xs text-gray-400 mt-1" id="statOrderSub">in period</p>
    </div>
    <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-1">Avg order value</p>
        <p class="text-2xl font-semibold text-gray-900" id="statAvg">—</p>
        <p class="text-xs text-gray-400 mt-1">per order</p>
    </div>
    <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-1">Pending</p>
        <p class="text-2xl font-semibold text-gray-900" id="statPending">—</p>
        <p class="text-xs text-gray-400 mt-1">awaiting fulfillment</p>
    </div>
</div>

<div class="grid grid-cols-1 gap-4 mb-6 lg:grid-cols-3">

    <div class="lg:col-span-2 bg-white border border-gray-100 rounded-2xl p-5">
        <p class="text-sm font-semibold text-gray-900 mb-1">Revenue by month</p>
        <p class="text-xs text-gray-400 mb-4" id="barSub">All statuses · last 12 months</p>
        <div id="barLegend" class="flex flex-wrap gap-4 mb-3 text-xs text-gray-500"></div>
        <div style="position: relative; width: 100%; height: 240px;">
            <canvas id="barChart" role="img" aria-label="Bar chart showing monthly revenue over the selected period">
                Monthly revenue chart
            </canvas>
        </div>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl p-5">
        <p class="text-sm font-semibold text-gray-900 mb-1">Orders by status</p>
        <p class="text-xs text-gray-400 mb-4">Current period breakdown</p>
        <div id="pieLegend" class="flex flex-col gap-2 mb-3 text-xs text-gray-500"></div>
        <div style="position: relative; width: 100%; height: 200px;">
            <canvas id="pieChart" role="img" aria-label="Doughnut chart showing order count by status">
                Order status breakdown
            </canvas>
        </div>
    </div>

</div>

<div class="bg-white border border-gray-100 rounded-2xl p-5">
    <p class="text-sm font-semibold text-gray-900 mb-1">Top products</p>
    <p class="text-xs text-gray-400 mb-4">By units sold in selected period</p>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-100">
                    <th class="text-left text-xs font-semibold uppercase tracking-widest text-gray-400 pb-3">Product</th>
                    <th class="text-left text-xs font-semibold uppercase tracking-widest text-gray-400 pb-3">Category</th>
                    <th class="text-right text-xs font-semibold uppercase tracking-widest text-gray-400 pb-3">Units sold</th>
                    <th class="text-right text-xs font-semibold uppercase tracking-widest text-gray-400 pb-3">Revenue</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                <tr>
                    <td colspan="4" class="text-center text-gray-400 py-8 text-sm">Loading...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}