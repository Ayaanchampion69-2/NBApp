@model NBApp.ViewModels.PagedOrdersViewModel
@{
    ViewData["Title"] = "My Orders";
}

<div class="bg-gray-50 p-6 rounded-xl min-h-screen">

    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-xl font-medium text-gray-900">My Orders</h1>
            <p class="text-sm text-gray-500 mt-0.5">@Model.TotalCount orders found</p>
        </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <table class="w-full text-sm border-collapse">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider border-b border-gray-100">Order date</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider border-b border-gray-100">Total amount</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider border-b border-gray-100">Account</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider border-b border-gray-100">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Orders)
                {
                    <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 text-gray-500">
                            @Html.DisplayFor(m => item.OrderDate)
                        </td>
                        <td class="px-4 py-3 font-medium text-gray-900">
                            $@Html.DisplayFor(m => item.TotalAmount)
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-full bg-blue-50 text-blue-700 flex items-center justify-content-center text-xs font-medium">
                                    @if (item.User.ProfilePicturePath != null)
                                    {
                                        <img src="@item.User.ProfilePicturePath" class="w-6 h-6 rounded-full object-cover" />
                                    }
                                    else
                                    {
                                            @item.User.DisplayName?.Substring(0, 1).ToUpper() 
                                    }
                                </div>
                                @Html.DisplayFor(m => item.User.DisplayName)
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-1">
                                <a asp-action="Edit" asp-route-id="@item.OrderId"
                                   class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-700 hover:opacity-80 transition-opacity">
                                    Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@item.OrderId"
                                   class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors">
                                    Details
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.OrderId"
                                   class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium bg-red-50 text-red-600 hover:opacity-80 transition-opacity">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <div class="flex items-center justify-between px-4 py-3 border-t border-gray-100">
                <p class="text-xs text-gray-500">
                    Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)) of @Model.TotalCount
                </p>
                <div class="flex items-center gap-1">
                    <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                       class="px-2.5 py-1 rounded-md text-xs font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors @(!Model.HasPreviousPage ? "opacity-40 pointer-events-none" : "")">
                        ← Prev
                    </a>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a asp-action="Index" asp-route-page="@i"
                           class="px-2.5 py-1 rounded-md text-xs font-medium border transition-colors
                            @(i == Model.CurrentPage
                               ? "bg-blue-600 text-white border-blue-600"
                               : "border-gray-200 text-gray-600 hover:bg-gray-50")">
                            @i
                        </a>
                    }

                    <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                       class="px-2.5 py-1 rounded-md text-xs font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors @(!Model.HasNextPage ? "opacity-40 pointer-events-none" : "")">
                        Next →
                    </a>
                </div>
            </div>
        }

    </div>
</div>