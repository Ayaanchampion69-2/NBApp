@model IEnumerable<NBApp.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-medium">Categories</h1>
    <a asp-action="Create"
       class="inline-flex items-center gap-1.5 bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700">
        + New category
    </a>
</div>

<div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <table class="w-full border-collapse text-sm">
        <thead>
            <tr>
                <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wide px-3 pb-2 pt-3">Name</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wide px-3 pb-2 pt-3">Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="px-3 py-2.5 border-t border-gray-100 font-medium">
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td class="px-3 py-2.5 border-t border-gray-100 text-gray-500">
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td class="px-3 py-2.5 border-t border-gray-100">
                        <div class="flex items-center gap-2">
                            <a asp-action="Edit" asp-route-id="@item.CategoryId"
                               class="text-blue-600 hover:text-blue-800 underline text-sm">Edit</a>
                            <span class="text-gray-300">|</span>
                            <a asp-action="Details" asp-route-id="@item.CategoryId"
                               class="text-blue-600 hover:text-blue-800 underline text-sm">Details</a>
                            <span class="text-gray-300">|</span>
                            <a asp-action="Delete" asp-route-id="@item.CategoryId"
                               class="text-red-600 hover:text-red-800 underline text-sm">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>