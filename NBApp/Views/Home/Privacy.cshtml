@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="bg-gray-50 min-h-screen py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="text-center mb-10">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900">@ViewData["Title"]</h1>
            <p class="mt-2 text-sm text-gray-500">How NBApp collects, uses, and protects your information</p>
        </div>

        <div class="bg-white rounded-lg shadow-sm border border-gray-200 divide-y divide-gray-200">

            <!-- Information We Collect -->
            <section class="p-6 md:p-8">
                <h2 class="text-lg font-semibold text-gray-900 mb-3">Information We Collect</h2>
                <p class="text-gray-600 mb-3">We collect personal information from you, including information about your:</p>
                <ul class="list-disc list-inside space-y-1 text-gray-600">
                    <li>Name</li>
                    <li>Contact information</li>
                    <li>Billing or purchase information</li>
                    <li>Delivery location</li>
                </ul>
            </section>

            <!-- Why We Collect It -->
            <section class="p-6 md:p-8">
                <h2 class="text-lg font-semibold text-gray-900 mb-3">Why We Collect Your Information</h2>
                <p class="text-gray-600 mb-3">We collect your personal information in order to:</p>
                <ul class="list-disc list-inside space-y-1 text-gray-600">
                    <li>Complete orders</li>
                    <li>Deliver orders to specified locations</li>
                    <li>Maintain order history and invoices</li>
                    <li>Reference orders to the correct person</li>
                </ul>
            </section>

            <!-- Who We Share It With -->
            <section class="p-6 md:p-8">
                <h2 class="text-lg font-semibold text-gray-900 mb-3">Who We Share Your Information With</h2>
                <p class="text-gray-600 mb-2">Besides our staff, we share this information with:</p>
                <ul class="list-disc list-inside space-y-1 text-gray-600">
                    <li>Third-party APIs, so they can complete the tasks required to process and deliver your order</li>
                </ul>
            </section>

            <!-- Optional Information -->
            <section class="p-6 md:p-8">
                <h2 class="text-lg font-semibold text-gray-900 mb-3">Optional Information</h2>
                <p class="text-gray-600 mb-3">Providing some information is optional. However:</p>
                <ul class="list-disc list-inside space-y-1 text-gray-600">
                    <li>If you choose not to enter an <strong>email</strong>, we will be unable to provide invoices.</li>
                    <li>If you choose not to enter <strong>billing information</strong>, we will be unable to complete orders online.</li>
                    <li>If you choose not to enter a <strong>delivery location</strong>, we will be unable to deliver orders to a specified location.</li>
                </ul>
            </section>

            <!-- Security -->
            <section class="p-6 md:p-8">
                <h2 class="text-lg font-semibold text-gray-900 mb-3">How We Keep Your Information Safe</h2>
                <p class="text-gray-600">
                    We keep your information safe by storing it in encrypted databases, with access restricted to admin users only.
                </p>
            </section>

           
            

        </div>

    </div>
</div>