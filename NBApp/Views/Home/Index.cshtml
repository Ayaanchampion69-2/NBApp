@{
    ViewData["Title"] = "Home Page";
}

<div class="max-w-5xl mx-auto px-6">

    
    <div class="text-center pt-14 pb-10">
        <p class="text-xs tracking-[0.2em] uppercase text-pink-600 mb-3">Amazing flavours to check out</p>
        <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-stone-900 mb-3">Welcome to our ice cream shop</h1>
        <p class="max-w-md mx-auto text-stone-600 mb-6">Made by a local favourite &mdash; Right here in Fiji.</p>
        <div class="w-12 h-1 bg-indigo-700 mx-auto rounded-full"></div>
    </div>

    @*CAROUSEL*@
    <div class="mb-14">
        <div class="relative w-full overflow-hidden rounded-2xl border border-stone-200 bg-white h-64 sm:h-72">
            <div id="carousel-track" class="flex h-full transition-transform duration-700 ease-in-out">
                <div class="min-w-full h-full flex items-center justify-center bg-indigo-50">
                    <img src="/MiscPics/Meme1.jpg" class="h-40 w-auto max-w-[80%] object-cover rounded-lg shadow-sm" alt="Featured flavor 1">
                </div>
                <div class="min-w-full h-full flex items-center justify-center bg-pink-50">
                    <img src="/MiscPics/Meme2.jpg" class="h-40 w-auto max-w-[80%] object-cover rounded-lg shadow-sm" alt="Featured flavor 2">
                </div>
                <div class="min-w-full h-full flex items-center justify-center bg-emerald-50">
                    <img src="/MiscPics/meme3.jpg" class="h-40 w-auto max-w-[80%] object-cover rounded-lg shadow-sm" alt="Featured flavor 3">
                </div>
                <div class="min-w-full h-full flex items-center justify-center bg-indigo-50">
                    <img src="/MiscPics/meme4.jpg" class="h-40 w-auto max-w-[80%] object-cover rounded-lg shadow-sm" alt="Featured flavor 4">
                </div>
                <div class="min-w-full h-full flex items-center justify-center bg-pink-50">
                    <img src="/MiscPics/meme5.jpg" class="h-40 w-auto max-w-[80%] object-cover rounded-lg shadow-sm" alt="Featured flavor 5">
                </div>
            </div>

            <button onclick="moveCarousel(-1)" aria-label="Previous slide" class="absolute top-1/2 left-3 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 hover:bg-white border border-stone-200 text-indigo-700 flex items-center justify-center text-sm">&#10094;</button>
            <button onclick="moveCarousel(1)" aria-label="Next slide" class="absolute top-1/2 right-3 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 hover:bg-white border border-stone-200 text-indigo-700 flex items-center justify-center text-sm">&#10095;</button>
        </div>

        <div id="carousel-dots" class="flex items-center justify-center gap-2 mt-4"></div>
    </div>

    @*ABOUT US*@
    <div class="rounded-2xl border border-stone-200 bg-white p-8 sm:p-10 flex items-start gap-5 mb-6">
        <div class="w-11 h-11 rounded-full bg-indigo-50 text-indigo-700 flex items-center justify-center flex-shrink-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 21h8l1-9a5 5 0 0 0-10 0l1 9Z" /><path d="M9 12h6" /></svg>
        </div>
        <div class="flex-1">
            <h2 class="font-serif text-2xl text-stone-900 mb-2">About us</h2>
            <p class="text-stone-600 leading-relaxed">
                Replace this with a short, friendly description of your company &mdash; who you are, what you do, and why customers should trust you.
            </p>
        </div>
    </div>

    @*LOCATION*@ 
    <div class="rounded-2xl border border-stone-200 bg-emerald-50 p-8 sm:p-10 flex items-start gap-5 mb-14">
        <div class="w-11 h-11 rounded-full bg-white text-emerald-700 flex items-center justify-center flex-shrink-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10Z" /><circle cx="12" cy="11" r="2.3" /></svg>
        </div>
        <div class="flex-1">
            <h2 class="font-serif text-2xl text-stone-900 mb-2">Location</h2>
            <p id="shop-address" class="text-stone-600 leading-relaxed mb-4">
                Replace this with your business address, hours, and any directions or parking notes customers might need.
            </p>

            <details class="group mb-4">
                <summary class="list-none inline-flex items-center gap-1.5 text-sm font-medium text-indigo-700 cursor-pointer">
                    Store hours
                    <svg class="transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
                </summary>
                <div class="mt-3 text-sm grid grid-cols-[auto_auto] gap-x-8 gap-y-1 text-stone-600">
                    <span>TBD</span>
                </div>
            </details>

            <a id="directions-link" href="#" target="_blank" rel="noopener" data-address="51 Victor Street Avondale Auckland" class="inline-block text-sm font-medium text-white bg-indigo-700 hover:bg-indigo-800 px-4 py-2 rounded-full transition">Get directions</a>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/HomeCarousel.js"></script>
}