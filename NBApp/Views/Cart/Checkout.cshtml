@using NBApp.ViewModels
@using NBApp.Models
@model CartViewModel

@{
    ViewData["Title"] = "Checkout";
    var cities = ViewBag.Cities as List<City> ?? new List<City>();
    var suburbs = ViewBag.Suburbs as List<Suburb> ?? new List<Suburb>();
}

<h1 class="text-3xl font-bold text-gray-900 mb-6">Checkout</h1>

<script id="suburbs-data" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    suburbs.Select(s => new { s.SuburbID, s.SuburbName, s.CityID, DeliveryCost = s.DeliveryCost })
    ))
</script>

<div class="lg:grid lg:grid-cols-2 lg:gap-x-12">
    <div>
        <div class="bg-white shadow rounded-lg p-6 mb-6">
            <h2 class="text-lg font-medium text-gray-900 mb-4">Shipping Information</h2>
            <form id="checkout-form" onsubmit="return false;">
                <div class="mb-4 space-y-4">
                    <div>
                        <label for="buildingNumber" class="block text-sm font-medium text-gray-700 mb-2">Building Number</label>
                        <input type="text" name="buildingNumber" id="buildingNumber" required
                               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border"
                               placeholder="Enter your building number" />
                    </div>
                    <div>
                        <label for="street" class="block text-sm font-medium text-gray-700 mb-2">Street</label>
                        <input type="text" name="street" id="street" required
                               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border"
                               placeholder="Enter your street" />
                    </div>
                    <div>
                        <label for="citySelect" class="block text-sm font-medium text-gray-700 mb-2">City</label>
                        <select id="citySelect" required
                                class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border">
                            <option value="">-- Select city --</option>
                            @foreach (var city in cities)
                            {
                                <option value="@city.CityID">@city.CityName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="suburbId" class="block text-sm font-medium text-gray-700 mb-2">Suburb</label>
                        <select name="suburbId" id="suburbId" required disabled
                                class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border disabled:bg-gray-100 disabled:text-gray-400">
                            <option value="">-- Select city first --</option>
                        </select>
                    </div>
                </div>

                <div class="border-t border-gray-200 pt-6 mt-6">
                    <h2 class="text-lg font-medium text-gray-900 mb-4">Payment</h2>

                    <!-- Stripe (card) payment -->
                    <div id="payment-element" class="mb-4"></div>
                    <div id="error-message" class="mb-4 text-red-500 text-sm hidden"></div>
                    <button type="button" id="pay-btn"
                            data-label="Pay @Model.Total.ToString("C")"
                            class="w-full rounded-md bg-indigo-600 px-4 py-3 text-base font-semibold text-white shadow-sm hover:bg-indigo-500">
                        Pay @Model.Total.ToString("C") with Card
                    </button>

                    <!-- M-PAiSA payment -->
                    <div class="relative my-4">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-200"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="bg-white px-2 text-gray-500">or</span>
                        </div>
                    </div>

                    <div id="mpaisa-error-message" class="mb-4 text-red-500 text-sm hidden"></div>
                    <button type="button" id="mpaisa-pay-btn"
                            class="w-full rounded-md bg-emerald-600 px-4 py-3 text-base font-semibold text-white shadow-sm hover:bg-emerald-500">
                        Pay @Model.Total.ToString("C") with M-PAiSA
                    </button>
                </div>
            </form>
        </div>

        <a asp-action="Index" class="inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-500">
            <svg class="mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" />
            </svg>
            Back to Cart
        </a>
    </div>

    <div>
        <div class="bg-white shadow rounded-lg p-6">
            <h2 class="text-lg font-medium text-gray-900 mb-4">Order Summary</h2>

            <ul role="list" class="divide-y divide-gray-200 mb-6">
                @foreach (var item in Model.Items)
                {
                    <li class="flex py-4">
                        <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-md border border-gray-200">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="h-full w-full object-cover object-center" />
                            }
                            else
                            {
                                <div class="h-full w-full bg-gray-200 flex items-center justify-center">
                                    <svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="text-sm font-medium text-gray-900">@item.ProductName</p>
                            <p class="text-sm text-gray-500">Qty: @item.Quantity × @item.Price.ToString("C")</p>
                        </div>
                        <p class="text-sm font-medium text-gray-900">@item.TotalPrice.ToString("C")</p>
                    </li>
                }
            </ul>

            <dl class="space-y-4 border-t border-gray-200 pt-4">
                <div class="flex items-center justify-between">
                    <dt class="text-sm text-gray-600">Subtotal</dt>
                    <dd class="text-sm font-medium text-gray-900">@Model.SubTotal.ToString("C")</dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-sm text-gray-600">Surcharge (3%)</dt>
                    <dd class="text-sm font-medium text-gray-900">@Model.Surcharge.ToString("C")</dd>
                </div>
                <div class="flex items-center justify-between" id="delivery-row" style="display:none !important;">
                    <dt class="text-sm text-gray-600">Delivery</dt>
                    <dd class="text-sm font-medium text-gray-900" id="delivery-cost">$0.00</dd>
                </div>
                <div class="flex items-center justify-between border-t border-gray-200 pt-4">
                    <dt class="text-base font-medium text-gray-900">Total</dt>
                    <dd class="text-base font-medium text-gray-900" id="order-total">@Model.Total.ToString("C")</dd>
                </div>
            </dl>
        </div>
    </div>
</div>

<!-- Real POST form for M-PAiSA. Hidden and submitted via JS once the shipping
     fields above (which live in the Stripe form) pass validation. A real
     server round-trip is needed here (not fetch/JS) because MPaisaCheckout
     redirects the browser straight to the M-PAiSA gateway. -->
<form id="mpaisa-form" asp-action="MPaisaCheckout" asp-controller="Cart" method="post" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="buildingNumber" id="mpaisa-buildingNumber" />
    <input type="hidden" name="street" id="mpaisa-street" />
    <input type="hidden" name="suburbId" id="mpaisa-suburbId" />
</form>

@section Scripts {
    <div id="stripe-data"
         data-publishable-key="@ViewBag.PublishableKey"
         data-client-secret="@ViewBag.ClientSecret"
         data-return-url="@Url.Action("PaymentSuccess", "Cart", null, Context.Request.Scheme)"
         data-base-total="@Model.Total"
         style="display:none;">
    </div>

    <script src="https://js.stripe.com/v3/"></script>
    <script src="~/js/Payment.js"></script>
}