@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="flex items-start justify-center px-4 pt-12 pb-16">
    <div style="width: 100%; max-width: 420px;">
        <div class="bg-white px-8 pt-8 pb-8 shadow-sm rounded-lg border border-gray-200">
            <h1 class="text-xl font-medium text-gray-900 mb-6">Register</h1>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post"
                  enctype="multipart/form-data" class="space-y-4">

                <div asp-validation-summary="ModelOnly"
                     class="rounded-md bg-red-50 p-4 text-sm text-red-700" role="alert"></div>

                <div>
                    <input asp-for="Input.DisplayName" autocomplete="username" aria-required="true"
                           placeholder="Username"
                           class="block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900
                    border border-gray-300 placeholder:text-gray-400
                    focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" />
                    <span asp-validation-for="Input.DisplayName" class="mt-1 text-xs text-red-600"></span>
                </div>

                <div>
                    <input asp-for="Input.Email" autocomplete="email" aria-required="true"
                           placeholder="Email"
                           class="block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900
                    border border-gray-300 placeholder:text-gray-400
                    focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" />
                    <span asp-validation-for="Input.Email" class="mt-1 text-xs text-red-600"></span>
                </div>

                <div>
                    <input asp-for="Input.Password" autocomplete="new-password" aria-required="true"
                           placeholder="Password"
                           class="block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900
                    border border-gray-300 placeholder:text-gray-400
                    focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" />
                    <span asp-validation-for="Input.Password" class="mt-1 text-xs text-red-600"></span>
                </div>

                <div>
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true"
                           placeholder="Confirm Password"
                           class="block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900
                    border border-gray-300 placeholder:text-gray-400
                    focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" />
                    <span asp-validation-for="Input.ConfirmPassword" class="mt-1 text-xs text-red-600"></span>
                </div>

                <div>
                    <label for="Input_ProfilePicture"
                           class="inline-flex items-center gap-2 cursor-pointer rounded-md border
                        border-gray-300 bg-white px-4 py-2 text-sm text-gray-600
                        hover:bg-gray-50 transition-colors">
                        <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0
                            012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0
                            00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Choose profile picture
                        <span class="text-xs text-gray-400">(optional)</span>
                        <span id="pfp-label" class="text-xs text-gray-400">No file chosen</span>
                        <input asp-for="Input.ProfilePicture" type="file" accept="image/*"
                               class="sr-only"
                               onchange="document.getElementById('pfp-label').textContent =
                        this.files[0]?.name ?? 'No file chosen'" />
                    </label>
                    <span asp-validation-for="Input.ProfilePicture" class="mt-1 text-xs text-red-600"></span>
                </div>

                <div class="flex items-center justify-between pt-4 mt-2 pb-2 border-t border-gray-100">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl"
                       class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium
                        text-gray-600 hover:bg-gray-50 transition-colors">
                        Existing user?
                    </a>
                    <button id="registerSubmit" type="submit"
                            class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium
                        text-white hover:bg-indigo-500 active:scale-[0.99] transition-colors">
                        Register
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}