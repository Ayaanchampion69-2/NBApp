@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="max-w-xl mx-auto p-6">
    <div class="bg-white rounded-xl border border-gray-200 p-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-1">@ViewData["Title"]</h3>
        <p class="text-sm text-gray-500 mb-6">Update your photo and personal details.</p>

        <partial name="_StatusMessage" for="StatusMessage" />

        <form id="profile-form" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4" role="alert"></div>

            <!-- Profile picture -->
            <div class="flex items-center gap-4 mb-8">
                @if (!string.IsNullOrEmpty(Model.Input.CurrentProfilePicturePath))
                {
                    <img src="@Model.Input.CurrentProfilePicturePath" alt="Profile picture"
                         class="w-20 h-20 rounded-full object-cover border border-gray-200" />
                }
                else
                {
                    <div class="w-20 h-20 rounded-full bg-gray-100 border border-gray-200 flex items-center justify-center text-gray-400 text-xs">
                        No photo
                    </div>
                }
                <div class="flex flex-col gap-1">
                    <label asp-for="Input.ProfilePicture"
                           class="inline-flex items-center gap-2 text-sm px-3 py-1.5 border border-gray-300 rounded-md cursor-pointer hover:bg-gray-50 w-fit text-gray-700">
                        Choose photo
                    </label>
                    <input asp-for="Input.ProfilePicture" type="file" accept="image/*" class="hidden" />
                    <span class="text-xs text-gray-400">JPG or PNG, up to 2MB</span>
                    <span asp-validation-for="Input.ProfilePicture" class="text-red-600 text-xs"></span>
                </div>
            </div>

            <!-- Fields -->
            <div class="flex flex-col gap-5 mb-8">
                <div>
                    <label asp-for="Input.DisplayName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Input.DisplayName" placeholder="Display Name"
                           class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 hover:border-gray-400" />
                    <span asp-validation-for="Input.DisplayName" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Input.PhoneNumber" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Input.PhoneNumber" placeholder="Please enter your phone number."
                           class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 hover:border-gray-400" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-red-600 text-xs"></span>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                <button id="update-profile-button" type="submit"
                        class="px-4 py-2 rounded-md text-sm font-medium bg-blue-600 text-white hover:bg-blue-700 transition-colors">
                    Save changes
                </button>

                @if (!string.IsNullOrEmpty(Model.Input.CurrentProfilePicturePath))
                {
                    <button type="submit" form="remove-picture-form" asp-page-handler="DeletePicture"
                            class="text-sm text-red-500 hover:text-red-600 hover:underline">
                        Remove photo
                    </button>
                }
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.Input.CurrentProfilePicturePath))
        {
            <form id="remove-picture-form" method="post" class="hidden"></form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}