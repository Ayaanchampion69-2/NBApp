@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "External logins";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="page-header mb-6">
    <h1 class="text-2xl font-medium text-gray-900">External logins</h1>
    <p class="text-sm text-gray-500 mt-0.5">Connect a third-party account for faster sign-in</p>
</div>

@if (Model.CurrentLogins?.Count > 0)
{
    <div class="bg-white border border-gray-200 rounded-xl p-6 max-w-lg mb-4">
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-4">Connected accounts</p>

        @foreach (var login in Model.CurrentLogins)
        {
            <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
                <span id="@($"login-provider-{login.LoginProvider}")"
                      class="text-sm font-medium text-gray-900">
                    @login.ProviderDisplayName
                </span>

                @if (Model.ShowRemoveButton)
                {
                    <form id="@($"remove-login-{login.LoginProvider}")"
                          asp-page-handler="RemoveLogin" method="post">
                        <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                        <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                        <button type="submit"
                                title="Remove this @login.ProviderDisplayName login from your account"
                                class="text-xs text-red-500 hover:text-red-700 font-medium transition-colors">
                            Remove
                        </button>
                    </form>
                }
            </div>
        }
    </div>
}

@if (Model.OtherLogins?.Count > 0)
{
    <div class="bg-white border border-gray-200 rounded-xl p-6 max-w-lg">
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-4">Add a login provider</p>

        <form id="link-login-form" asp-page-handler="LinkLogin" method="post">
            @foreach (var provider in Model.OtherLogins)
            {
                <button id="@($"link-login-button-{provider.Name}")"
                        type="submit"
                        name="provider"
                        value="@provider.Name"
                        title="Log in using your @provider.DisplayName account"
                        class="flex items-center justify-between w-full px-4 py-3 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors mb-3 last:mb-0 text-left">
                    <span class="text-sm font-medium text-gray-900">@provider.DisplayName</span>
                    <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            }
        </form>

        <hr class="border-gray-100 my-5" />
        <p class="text-xs text-gray-400">
            Connecting a provider lets you sign in without a password. You can remove it at any time from this page.
        </p>
    </div>
}

@if (Model.CurrentLogins?.Count == 0 && Model.OtherLogins?.Count == 0)
{
    <div class="bg-white border border-gray-200 rounded-xl p-6 max-w-lg">
        <p class="text-sm text-gray-400">No external login providers are configured.</p>
    </div>
}