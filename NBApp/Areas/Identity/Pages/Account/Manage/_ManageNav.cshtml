@using NBApp.Models
@inject SignInManager<NBAppUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<ul class="flex flex-col py-2">
    <li>
        <a class="flex items-center gap-2 px-4 py-2 text-sm @(ManageNavPages.IndexNavClass(ViewContext) == "active" ? "bg-blue-50 text-blue-700 font-medium border-r-2 border-blue-500" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900")"
           id="profile" asp-page="./Index">
            Profile
        </a>
    </li>
    <li>
        <a class="flex items-center gap-2 px-4 py-2 text-sm @(ManageNavPages.EmailNavClass(ViewContext) == "active" ? "bg-blue-50 text-blue-700 font-medium border-r-2 border-blue-500" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900")"
           id="email" asp-page="./Email">
            Email
        </a>
    </li>
    <li>
        <a class="flex items-center gap-2 px-4 py-2 text-sm @(ManageNavPages.ChangePasswordNavClass(ViewContext) == "active" ? "bg-blue-50 text-blue-700 font-medium border-r-2 border-blue-500" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900")"
           id="change-password" asp-page="./ChangePassword">
            Password
        </a>
    </li>
    @if (hasExternalLogins)
    {
        <li>
            <a class="flex items-center gap-2 px-4 py-2 text-sm @(ManageNavPages.ExternalLoginsNavClass(ViewContext) == "active" ? "bg-blue-50 text-blue-700 font-medium border-r-2 border-blue-500" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900")"
               id="external-login" asp-page="./ExternalLogins">
                External logins
            </a>
        </li>
    }
    <li>
        <a class="flex items-center gap-2 px-4 py-2 text-sm @(ManageNavPages.PersonalDataNavClass(ViewContext) == "active" ? "bg-blue-50 text-blue-700 font-medium border-r-2 border-blue-500" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900")"
           id="personal-data" asp-page="./PersonalData">
            Personal data
        </a>
    </li>
</ul>