@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="min-h-[70vh] flex items-start justify-center pt-16 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">

            <div class="mb-6">
                <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center mb-4">
                    <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                    </svg>
                </div>
                <h1 class="text-xl font-bold text-gray-900">@ViewData["Title"]</h1>
                <p class="text-sm text-gray-500 mt-1">Enter your email and we'll send you a reset link.</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 mb-4 space-y-1" role="alert"></div>

            <form method="post" class="space-y-5">
                <div>
                    <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input asp-for="Input.Email"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 shadow-sm
                    focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-xs text-red-600 mt-1 block"></span>
                </div>

                <button type="submit"
                        class="w-full inline-flex justify-center items-center rounded-lg bg-blue-600 px-4 py-2.5
                    text-sm font-semibold text-white shadow-sm hover:bg-blue-700
                    focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition">
                    Reset password
                </button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}