@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="flex items-start justify-center px-4 pt-12 pb-16">
    <div style="width: 100%; max-width: 420px;">
        <div class="bg-white px-8 pt-8 pb-8 shadow-sm rounded-lg border border-gray-200">
            <h1 class="text-xl font-medium text-gray-900 mb-1">Log in</h1>
            <p class="text-sm text-gray-500 mb-6">Use a local account to log in.</p>

            <form id="account" method="post" class="space-y-4">

                <div asp-validation-summary="ModelOnly"
                     class="rounded-md bg-red-50 p-4 text-sm text-red-700" role="alert"></div>

                <div>
                    <input asp-for="Input.Email"
                           class="block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900
                    border border-gray-300 placeholder:text-gray-400
                    focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="Email" />
                    <span asp-validation-for="Input.Email" class="mt-1 text-xs text-red-600"></span>
                </div>

                <div>
                    <input asp-for="Input.Password"
                           class="block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900
                    border border-gray-300 placeholder:text-gray-400
                    focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="Password" />
                    <span asp-validation-for="Input.Password" class="mt-1 text-xs text-red-600"></span>
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="Input.RememberMe"
                           class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-400" />
                    <label asp-for="Input.RememberMe" class="text-sm text-gray-600">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <div class="flex items-center justify-between pt-4 mt-2 pb-2 border-t border-gray-100">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"
                       class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium
                        text-gray-600 hover:bg-gray-50 transition-colors">
                        Register
                    </a>
                    <button id="login-submit" type="submit"
                            class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium
                        text-white hover:bg-indigo-500 active:scale-[0.99] transition-colors">
                        Log in
                    </button>
                </div>

                <div class="border-t border-gray-100 pt-4 flex flex-col gap-2">
                    <a asp-page="./ForgotPassword"
                       class="text-sm text-indigo-600 hover:text-indigo-500 transition-colors w-fit">
                        Forgot password?
                    </a>
                    <a asp-page="./ResendEmailConfirmation"
                       class="text-sm text-indigo-600 hover:text-indigo-500 transition-colors w-fit">
                        Resend confirmation
                    </a>
                </div>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <hr class="border-gray-100" />
                    <p class="text-sm text-gray-500">Use another service to log in.</p>
                    <form id="external-account" asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="flex gap-2 flex-wrap">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                if (provider.Name == "Google")
                                {
                                    <button type="submit" name="provider" value="@provider.Name"
                                            class="flex items-center gap-2 rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="width:18px;height:18px;">
                                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05" />
                                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                                        </svg>
                                        Google
                                    </button>
                                }
                                else if (provider.Name == "Facebook")
                                {
                                    <button type="submit" name="provider" value="@provider.Name"
                                            class="flex items-center gap-2 rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="width:18px;height:18px;">
                                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" fill="#1877F2" />
                                        </svg>
                                        Facebook
                                    </button>
                                }
                            }
                        </div>
                    </form>
                }

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}