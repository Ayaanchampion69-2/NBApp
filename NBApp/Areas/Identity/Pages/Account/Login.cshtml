@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="flex items-center justify-center min-h-[70vh]">
    <div class="bg-white rounded-xl shadow-md w-full max-w-2xl p-8">
        <h1 class="text-2xl font-bold text-gray-800 mb-6">Log in</h1>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4" role="alert"></div>

            <p class="text-sm text-gray-500 mb-6">Use a local account to log in.</p>

            <!-- Email -->
            <div class="mb-4">
                <input asp-for="Input.Email"
                       class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-400"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="Email" />
                <span asp-validation-for="Input.Email" class="text-red-500 text-xs mt-1"></span>
            </div>

            <!-- Password -->
            <div class="mb-4">
                <input asp-for="Input.Password"
                       class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-400"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Password" />
                <span asp-validation-for="Input.Password" class="text-red-500 text-xs mt-1"></span>
            </div>

            <!-- Remember Me -->
            <div class="flex items-center mb-6 gap-2">
                <input class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-400"
                       asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe" class="text-sm text-gray-600">
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <!-- Buttons Row -->
            <div class="flex items-center justify-between">
                <div class="flex flex-col gap-1 text-sm">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"
                       class="text-gray-500 border border-gray-300 rounded-lg px-4 py-2 hover:bg-gray-50 text-center">
                        Register
                    </a>
                </div>

                <button id="login-submit" type="submit"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-6 py-2 rounded-lg transition-colors">
                    Log in
                </button>
            </div>

            <!-- Extra Links -->
            <div class="mt-5 flex flex-col gap-1 text-sm text-indigo-500">
                <a id="forgot-password" asp-page="./ForgotPassword" class="hover:underline">Forgot your password?</a>
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="hover:underline">Resend email confirmation</a>
            </div>

            <!-- External Logins -->
            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <hr class="my-6 border-gray-200" />
                <p class="text-sm text-gray-500 mb-3">Use another service to log in.</p>
                <form id="external-account" asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="flex gap-2 flex-wrap">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm px-4 py-2 rounded-lg"
                                    name="provider" value="@provider.Name">
                                @provider.DisplayName
                            </button>
                        }
                    </div>
                </form>
            }
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}